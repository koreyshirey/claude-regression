# Raw transcripts contain plaintext secrets (wifi passwords, emails, API keys,
# vault variable names). Never let these reach shelf or any shared remote.
archive/
blind_sample.txt
sample_key.json

# Derived outputs, regenerated by the scripts. metrics.json in particular
# embeds verbatim message excerpts in its `examples` field -- do not commit it.
metrics.json
metrics2.json
episodes.json

# Derived aggregates are safe to commit -- they are counts, not content.
!metrics_history.jsonl

# Per-machine source id -- if this shipped, every cloner would inherit the
# author's id and their rows would overwrite each other again.
.source

# Escalation drafts / working notes, not part of the tool.
escalation/
